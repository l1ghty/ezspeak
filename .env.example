# Copy to .env and adjust. Everything is optional — `docker compose up -d`
# works without a .env file (the TURN secret is generated automatically).

# Port ezspeak listens on (on the host)
EZSPEAK_PORT=3111
# Behind Coolify/Traefik/nginx?
TRUST_PROXY=false

# Hosting limits
MAX_SERVERS=100
MAX_SERVERS_PER_IP=5
MAX_USERS_PER_SERVER=50
MAX_USERS_PER_CHANNEL=10
MAX_CHANNELS_PER_SERVER=20
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=20

# Relay (TURN). Leave TURN_SECRET empty to auto-generate (stored in the
# `secrets` volume). Setting it overrides the stored one.
TURN_SECRET=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Empty = turn:<page host>:TURN_PORT. Set if TURN runs on another hostname.
TURN_URLS=
# Public IP when the host is behind NAT (home server, some clouds): IP or "auto"
TURN_EXTERNAL_IP=
# Only for LAN/local testing
TURN_ALLOW_LAN=false
# Hide all IPs on every server
FORCE_RELAY=false
