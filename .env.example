# Copy to .env and adjust. Everything is optional — `docker compose up -d`
# works without a .env file (the TURN secret is generated automatically).

# Port ezspeak listens on (on the host)
EZSPEAK_PORT=3111
# Behind Coolify/Traefik/nginx? true (one proxy) or the number of proxies.
# Only when the app isn't reachable directly — otherwise clients can spoof their IP.
TRUST_PROXY=false
# Other websites allowed to use this server's WebSocket (own origin is always allowed)
ALLOWED_ORIGINS=

# Hosting limits
MAX_SERVERS=100
MAX_SERVERS_PER_IP=5
MAX_USERS_PER_SERVER=50
MAX_USERS_PER_CHANNEL=10
MAX_CHANNELS_PER_SERVER=20
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=20
# New connections per IP per minute
CONNECT_RATE_PER_IP=60
# Wrong server passwords per IP per 10 minutes before lockout
PASSWORD_FAILS_PER_IP=10

# Relay (TURN). Leave TURN_SECRET empty to auto-generate (stored in the
# `secrets` volume). Setting it overrides the stored one.
TURN_SECRET=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Empty = turn:<page host>:TURN_PORT. Set if TURN runs on another hostname.
TURN_URLS=
# Public IP when the host is behind NAT (home server, some clouds): IP or "auto"
TURN_EXTERNAL_IP=
# TURN credential lifetime (s); clients refresh automatically
TURN_TTL=21600
# Relay abuse limits: sessions total / per user, bytes per second per session
TURN_TOTAL_QUOTA=1000
TURN_USER_QUOTA=30
TURN_MAX_BPS=500000
# Only for LAN/local testing
TURN_ALLOW_LAN=false
# Hide all IPs on every server
FORCE_RELAY=false
